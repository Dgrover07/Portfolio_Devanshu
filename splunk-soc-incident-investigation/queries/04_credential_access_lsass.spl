-- ============================================================================
-- OPERATION BLACKBYTE: SPLUNK SIEM INCIDENT INVESTIGATION
-- Phase 4: Credential Access & LSASS Memory Dumping
-- MITRE ATT&CK: T1003.001 (LSASS Memory), T1218.011 (Rundll32), T1078.002 (Domain Accounts)
-- ============================================================================

-- ----------------------------------------------------------------------------
-- 1. High-Fidelity Detection: Unauthorized Process Access to LSASS (Sysmon EID 10)
-- ----------------------------------------------------------------------------
index=incident_lab sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=10
| search TargetImage="*\\lsass.exe"
| eval GrantedAccess_Hex=tostring(GrantedAccess)
| eval SuspiciousAccess=case(
    GrantedAccess IN ("0x1FFFFF", "0x1F3FFF"), "Full Access Rights (Mimikatz / High Risk)",
    GrantedAccess IN ("0x1010", "0x1410", "0x143a"), "Memory Read / MiniDump Rights (comsvcs / procdump)",
    1=1, "Standard Query Access"
  )
| where SuspiciousAccess!="Standard Query Access"
| table _time, Computer, SourceUser, SourceImage, SourceProcessId, TargetImage, GrantedAccess, SuspiciousAccess, CallTrace
| sort - _time;

-- ----------------------------------------------------------------------------
-- 2. Catch Native LOLBin Memory Dump via rundll32.exe & comsvcs.dll (Sysmon EID 1)
-- ----------------------------------------------------------------------------
index=incident_lab sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 Image="*\\rundll32.exe"
| search CommandLine="*comsvcs*" OR CommandLine="*MiniDump*"
| rex field=CommandLine "(?i)MiniDump\s+(?<TargetPID>\d+)\s+(?<DumpFile>[^\s]+)"
| table _time, Computer, User, ParentImage, CommandLine, TargetPID, DumpFile;

-- ----------------------------------------------------------------------------
-- 3. Verify Memory Dump File Creation on Disk (Sysmon EID 11)
-- ----------------------------------------------------------------------------
index=incident_lab sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=11
| search TargetFilename="*\\lsass.dmp" OR TargetFilename="*.dmp" OR TargetFilename="*\\Temp\\*.bin"
| table _time, Computer, User, Image, TargetFilename, ProcessId;

-- ----------------------------------------------------------------------------
-- 4. Hunt for Suspicious Privilege Assignment (WinEventLog:Security EID 4672)
-- ----------------------------------------------------------------------------
index=incident_lab sourcetype="WinEventLog:Security" EventCode=4672
| search PrivilegeList="*SeDebugPrivilege*" OR PrivilegeList="*SeImpersonatePrivilege*"
| table _time, Computer, SubjectUserName, PrivilegeList;
